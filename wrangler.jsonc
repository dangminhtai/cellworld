{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cellworld-backend",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name":"WORLD","class_name":"WorldObject"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["WorldObject"]}],
  "vars": {"ALLOWED_ORIGINS":"https://cellworld.pages.dev,http://127.0.0.1:5173,http://localhost:5173"}
}
